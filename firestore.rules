rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny for unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Products collection
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isValidId(productId);
    }

    // Variants collection
    match /variants/{variantId} {
      allow read: if true;
      allow create, update, delete: if isValidId(variantId);
    }

    // Customers collection (with Udhaar)
    match /customers/{customerId} {
      allow read: if true;
      allow create, update, delete: if isValidId(customerId);
    }

    // Invoices collection
    match /invoices/{invoiceId} {
      allow read: if true;
      allow create, update, delete: if isValidId(invoiceId);
    }

    // Stock movements audit log
    match /stockMoves/{moveId} {
      allow read: if true;
      allow create, update, delete: if isValidId(moveId);
    }

    // Shop settings
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isValidId(settingId);
    }
  }
}
